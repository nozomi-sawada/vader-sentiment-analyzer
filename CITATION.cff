    title: "VADER: A Parsimonious Rule-based Model for Sentiment Analysis of Social Media Text"
    authors:
      - family-names: Hutto
        given-names: "C.J."
      - family-names: Gilbert
        given-names: "E.E."
    collection-title: "Proceedings of the Eighth International Conference on Weblogs and Social Media (ICWSM-14), Ann Arbor, MI"
    year: 2014
    month: 6
