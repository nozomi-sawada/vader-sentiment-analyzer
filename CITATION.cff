    given-names: Nozomi
version: 2.0.0
date-released: "2026-09-13"
license: MIT
repository-code: "https://github.com/nozomi-sawada/vader-sentiment-analyzer"
url: "https://nozomi-sawada.github.io/vader-sentiment-analyzer/"
keywords:
  - sentiment analysis
  - VADER
  - natural language processing
  - text mining
  - research software
references:
